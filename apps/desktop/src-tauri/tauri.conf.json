{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RK",
  "version": "0.1.0",
  "identifier": "dev.noplab.rk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RK",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "nop",
    "category": "DeveloperTool",
    "shortDescription": "A 3D CAD editor",
    "longDescription": "RK is a 3D CAD editor for robotics, with a headless engine AI agents can drive.",
    "licenseFile": "../../../TERMS_OF_SERVICE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English", "Japanese"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
